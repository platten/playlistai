<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="playlist-ai"
        Arguments=""
        InstallLocation="C:\Program Files\Playlist AI\Playlist AI">
    </Installer>
    <PackageInformation
        PackageName="Playlist AI"
        PackageDisplayName="Playlist AI"
        PublisherName="CN=Playlist AI"
        PublisherDisplayName="Playlist AI"
        Version="0.1.0.0"
        PackageDescription="Local-first playlist recommendations over the Deej-AI embedding catalog.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.platten.playlistai"
                Description="Local-first playlist recommendations over the Deej-AI embedding catalog."
                DisplayName="Playlist AI"
                ExecutableName="playlist-ai"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Playlist AI</DisplayName>
            <PublisherDisplayName>Playlist AI</PublisherDisplayName>
            <Description>Local-first playlist recommendations over the Deej-AI embedding catalog.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="playlist-ai.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
